# ===================================================
# LMS AI Backend - Environment Configuration Template
# ===================================================

# Port & Server Configuration
PORT=4000
BACKEND_URL=http://localhost:4000

# Database (PostgreSQL / Neon Tech)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# JWT Authentication
SUPER_SECRET_KEY=your_super_secret_jwt_key_here

# Cloudinary (Media & Image Uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Nodemailer / Gmail SMTP Configuration
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password
MAIL_FROM=your_email@gmail.com

# SSLCommerz Payment Gateway
SSL_STORE_ID=your_sslcommerz_store_id
SSL_STORE_PASSWORD=your_sslcommerz_store_password

# AI Engine / LLM Provider (Groq / Gemini / OpenAI)
GROQ_API_KEY=your_groq_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
