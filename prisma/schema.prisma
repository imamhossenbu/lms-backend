generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- User Management ---
model User {
  id                  String    @id @default(uuid())
  name                String
  email               String    @unique
  password            String
  phone               String?
  avatar              String?
  role                String    @default("STUDENT")
  status              String    @default("PENDING")
  verificationToken   String?   @unique
  lastLoginAt         DateTime?
  /// Settings › Security › Login protection: wrong passwords in a row, and the lock they caused.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  /// Last password set / change (password expiry counts from here).
  passwordChangedAt   DateTime  @default(now())
  /// Last authenticated request (admin idle session timeout; updated at most once a minute).
  lastActiveAt        DateTime?

  bio           String?
  education     String?
  skills        String?
  interests     String?
  country       String?
  language      String?
  socialLinks   String?
  address       String?
  /// Professional title shown on instructor profiles, e.g. "Senior Web Developer".
  headline      String?
  /// Main subject area, e.g. "Web Development".
  expertise     String?
  certificates  Certificate[]
  attendances   Attendance[]
  liveQuestions LiveQuestion[]

  enrollments             Enrollment[]
  quizAttempts            QuizAttempt[]
  submissions             AssignmentSubmission[]
  lessonProgress          LessonProgress[]
  coursesTeaching         Course[]               @relation("CourseInstructor")
  notesAbout              StudentNote[]          @relation("NoteStudent")
  notesAuthored           StudentNote[]          @relation("NoteAuthor")
  instructorNotesAbout    InstructorNote[]       @relation("InstructorNoteInstructor")
  instructorNotesAuthored InstructorNote[]       @relation("InstructorNoteAuthor")
  reviews                 CourseReview[]
  orders                  Order[]
  liveClassesTaught       LiveClass[]            @relation("LiveClassInstructor")
  orderNotes              OrderNote[]            @relation("OrderNoteAuthor")
  notificationDeliveries  NotificationDelivery[]
  discussionReports       DiscussionReport[]     @relation("DiscussionReporter")
  consoleAlertReads       ConsoleAlertRead[]
  /// Soft delete — hidden from lists and blocked from login.
  deletedAt               DateTime?
  lastLoginIp             String?

  // Two-factor authentication (TOTP). The secret is AES-256-GCM encrypted (common/crypto.ts).
  twoFactorEnabled   Boolean   @default(false)
  twoFactorSecret    String?
  twoFactorEnabledAt DateTime?

  teamMembership  TeamMember?  @relation("TeamMemberUser")
  teamInvitesSent TeamMember[] @relation("TeamMemberInviter")
  emailVerified   Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  // SaaS tenant this user belongs to (null for the platform owner / legacy users)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([institutionId])
}

// --- Courses & Learning ---
model Category {
  id            String     @id @default(uuid())
  name          String
  slug          String
  /// Tenant (null = legacy single-tenant workspace). Slugs are unique per workspace.
  institutionId String?
  description   String?
  icon          String?
  status        String
  /// Parent category (null = top level). One level deep: a sub-category can't have children.
  parentId      String?
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children      Category[] @relation("CategoryTree")
  createdAt     DateTime   @default(now())
  courses       Course[]

  @@unique([institutionId, slug])
  @@index([institutionId])
  @@index([parentId])
}

model Course {
  id               String   @id @default(uuid())
  title            String
  slug             String
  /// Tenant (null = legacy single-tenant workspace). Slugs are unique per workspace.
  institutionId    String?
  description      String
  shortDescription String
  thumbnail        String?
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  instructorId     String
  instructor       User     @relation("CourseInstructor", fields: [instructorId], references: [id])
  level            String
  language         String
  price            Decimal
  isFree           Boolean  @default(false)
  status           String
  durationMinutes  Int
  requirements     String?
  learningOutcomes String?
  tags             String?
  ratingAverage    Decimal  @default(0)
  totalStudents    Int      @default(0)

  certificates   Certificate[]
  reviews        CourseReview[]
  orders         Order[]
  modules        CourseModule[]
  enrollments    Enrollment[]
  quizzes        Quiz[]
  assignments    Assignment[]
  lessonProgress LessonProgress[]
  liveClasses    LiveClass[]

  @@unique([institutionId, slug])
  @@index([instructorId])
  @@index([institutionId, status])
}

model CourseModule {
  id              String   @id @default(uuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  order           Int
  isLocked        Boolean  @default(true)
  createdAt       DateTime @default(now())
  durationMinutes Int      @default(0)

  lessons     Lesson[]
  assignments Assignment[]
  quizzes     Quiz[]
}

model Lesson {
  id       String       @id @default(uuid())
  courseId String
  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title           String
  type            String
  content         String?
  videoUrl        String?
  durationMinutes Int
  order           Int
  isPreview       Boolean          @default(false)
  resources       String?
  status          String
  /// Lesson editor fields without their own column (short description, visibility, publish date, thumbnail,
  /// player options, poster, subtitles, behaviour, access, drip, SEO, quiz, notes), in the panel's shape.
  editorSettings  Json?
  lessonResources LessonResource[]
  progress        LessonProgress[]
}

model LessonResource {
  id             String  @id @default(uuid())
  lessonId       String
  lesson         Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title          String
  fileUrl        String
  fileType       String
  size           String
  isDownloadable Boolean @default(true)
  description    String  @default("")
  /// Position in the lesson's resource list (0-based).
  order          Int     @default(0)
  /// Hidden resources stay on the lesson but aren't shown to students.
  isVisible      Boolean @default(true)
}

model Enrollment {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt         DateTime  @default(now())
  status             String
  progressPercentage Int       @default(0)
  completedAt        DateTime?
  lastAccessedAt     DateTime?

  @@unique([userId, courseId])
  @@index([courseId])
}

// --- Assessments ---
model LessonProgress {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted    Boolean   @default(false)
  watchedSeconds Int       @default(0)
  lastPosition   Int       @default(0)
  completedAt    DateTime?

  @@unique([userId, lessonId])
  @@index([userId, courseId])
}

/// Course quiz. First-version columns keep their names: description (descriptionHtml), passingScore (passing marks),
/// totalMarks (= sum of question points, maintained by the API).
model Quiz {
  id                     String        @id @default(uuid())
  /// SaaS tenant. null = legacy single-tenant data.
  institutionId          String?
  courseId               String
  course                 Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId               String?
  module                 CourseModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  lessonId               String        @default("")
  title                  String
  description            String?
  instructionsHtml       String        @default("")
  /// "BEGINNER" | "INTERMEDIATE" | "ADVANCED".
  difficulty             String        @default("BEGINNER")
  /// null = no time limit.
  timeLimitMinutes       Int?
  passingScore           Int
  totalMarks             Int
  /// "PUBLISHED" | "DRAFT" | "ARCHIVED".
  status                 String
  /// null = unlimited attempts.
  maxAttempts            Int?
  showCorrectAnswers     Boolean       @default(true)
  showExplanation        Boolean       @default(true)
  randomizeQuestions     Boolean       @default(false)
  randomizeOptions       Boolean       @default(false)
  /// Open from the start of this workspace-local day (null = immediately).
  startsAt               DateTime?
  /// Open until the end of this workspace-local day (null = no end).
  endsAt                 DateTime?
  /// "ENROLLED" | "ALL_STUDENTS" | "SPECIFIC_GROUPS".
  access                 String        @default("ENROLLED")
  requirePreviousLessons Boolean       @default(false)
  /// Show the result right after submitting.
  showImmediately        Boolean       @default(false)
  createdById            String?
  createdByName          String        @default("")
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @default(now()) @updatedAt

  questions QuizQuestion[]
  attempts  QuizAttempt[]
  events    QuizEvent[]

  @@index([courseId])
  @@index([institutionId])
}

/// questionText = questionHtml, questionType = kind, marks = points, explanation = explanationHtml.
/// options: JSON [{ id, text }] (legacy rows: JSON string[]); correctAnswer: text of the first correct option (legacy grading).
model QuizQuestion {
  id               String  @id @default(uuid())
  quizId           String
  quiz             Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)
  questionText     String
  questionType     String
  options          String
  correctAnswer    String
  /// Option ids that are correct.
  correctOptionIds Json    @default("[]")
  /// SHORT_ANSWER: accepted answers (case-insensitive).
  acceptedAnswers  Json    @default("[]")
  marks            Int
  explanation      String?
  order            Int
  /// null = no per-question limit.
  timeLimitSeconds Int?
  required         Boolean @default(true)
  shuffleOptions   Boolean @default(false)

  @@index([quizId])
}

model QuizAttempt {
  id               String   @id @default(uuid())
  quizId           String
  quiz             Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// What the student sent: JSON [{ questionId, optionIds?, text?, timeSeconds? }] (legacy: [{ questionId, answer }]).
  answers          String
  score            Int
  percentage       Decimal
  parsed           Boolean
  /// 1-based attempt number for this student.
  attemptNumber    Int      @default(1)
  /// Total marks at the time of the attempt (0 on legacy rows = use the quiz's).
  totalMarks       Int      @default(0)
  passed           Boolean  @default(false)
  /// false = started but not finished.
  completed        Boolean  @default(true)
  timeTakenSeconds Int      @default(0)
  /// Graded answers: [{ questionId, correct, timeSeconds }].
  results          Json     @default("[]")
  startedAt        DateTime @default(now())
  submittedAt      DateTime

  @@index([userId])
  @@index([quizId])
}

enum QuizEventKind {
  CREATED
  UPDATED
  PUBLISHED
  UNPUBLISHED
  ARCHIVED
  QUESTION_ADDED
  QUESTION_REMOVED
  SETTINGS_CHANGED
  DUPLICATED
}

/// Quiz › Activity Log tab.
model QuizEvent {
  id        String        @id @default(uuid())
  quizId    String
  quiz      Quiz          @relation(fields: [quizId], references: [id], onDelete: Cascade)
  kind      QuizEventKind
  message   String
  actorId   String?
  actorName String
  createdAt DateTime      @default(now())

  @@index([quizId, createdAt])
}

enum AssignmentType {
  FILE_UPLOAD
  TEXT
  LINK
}

enum AssignmentDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum AssignmentGradingType {
  POINTS
  PASS_FAIL
  LETTER
  NOT_GRADED
}

enum LateSubmissionPolicy {
  ALLOW
  ALLOW_WITH_PENALTY
  DISALLOW
}

enum AssignmentAvailability {
  UNTIL_DUE
  TIME_LIMIT
  WINDOW
}

/// Course assignment. Columns from the first version (description, dueDate, marks, allowedFileTypes, status)
/// keep their names; the admin panel calls them descriptionHtml, dueDate+dueTime, totalPoints, instructions.allowedFileTypes.
model Assignment {
  id               String        @id @default(uuid())
  /// SaaS tenant. null = legacy single-tenant data.
  institutionId    String?
  courseId         String
  course           Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  moduleId         String?
  module           CourseModule? @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  /// "" = not tied to a lesson.
  lessonId         String        @default("")
  title            String
  /// Rich-text HTML (sanitized).
  description      String?
  /// Due moment (the panel sends local "YYYY-MM-DD" + "HH:mm" in the workspace timezone).
  dueDate          DateTime
  /// Total points.
  marks            Int
  /// Comma-separated extensions without dots, e.g. "pdf,zip".
  allowedFileTypes String
  /// "PUBLISHED" | "DRAFT".
  status           String

  type              AssignmentType         @default(FILE_UPLOAD)
  category          String                 @default("")
  difficulty        AssignmentDifficulty   @default(BEGINNER)
  estimatedTime     Float                  @default(0)
  /// "MINUTES" | "HOURS".
  estimatedUnit     String                 @default("HOURS")
  instructionsHtml  String                 @default("")
  /// { overview, objectives[], tasks[], requirements[], gradingNotes[] }
  instructions      Json                   @default("{}")
  /// [{ id, name, url, size, format }]
  attachments       Json                   @default("[]")
  /// { enabled, title, description, visibleToStudents, criteria[{ id, title, description, points, levels[] }] }
  rubric            Json                   @default("{}")
  maxFiles          Int                    @default(1)
  maxFileSizeMb     Int                    @default(50)
  /// null = unlimited attempts.
  maxAttempts       Int?
  lateSubmission    LateSubmissionPolicy   @default(ALLOW)
  latePenalty       Float                  @default(0)
  /// "PERCENT" | "POINTS".
  latePenaltyUnit   String                 @default("PERCENT")
  gradingType       AssignmentGradingType  @default(POINTS)
  passingScore      Int?
  /// "EXACT" | "GRADE_ONLY".
  gradeDisplay      String                 @default("EXACT")
  showRubric        Boolean                @default(false)
  peerReview        Boolean                @default(false)
  aiGradingEnabled  Boolean                @default(false)
  aiGradingCriteria String                 @default("")
  manualOverride    Boolean                @default(true)
  /// When students can see it. null = immediately.
  releaseAt         DateTime?
  availability      AssignmentAvailability @default(UNTIL_DUE)
  timeLimitMinutes  Int                    @default(60)
  windowStartAt     DateTime?
  windowEndAt       DateTime?
  showInCalendar    Boolean                @default(true)
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @default(now()) @updatedAt

  submissions AssignmentSubmission[]

  @@index([courseId])
  @@index([institutionId])
}

model AssignmentSubmission {
  id               String     @id @default(uuid())
  assignmentId     String
  assignment       Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl          String?
  /// Original file name of the upload ("" for text / link answers).
  fileName         String     @default("")
  /// Text answer (TEXT) or the submitted URL (LINK).
  textAnswer       String?
  submittedAt      DateTime   @default(now())
  /// 1-based attempt number for this student.
  attempt          Int        @default(1)
  /// Submitted after the due moment.
  isLate           Boolean    @default(false)
  timeTakenMinutes Int?
  /// Score out of the assignment's total points. null until graded.
  marksObtained    Float?
  /// criterionId → points awarded.
  criterionScores  Json       @default("{}")
  feedback         String?
  aiFeedback       String?
  /// "PENDING" | "GRADED".
  status           String
  gradedAt         DateTime?
  gradedById       String?

  @@index([userId])
  @@index([assignmentId])
}

// --- Community ---
/// Community thread (admin panel › Community). Legacy rows: no institutionId, plain/HTML `body`, no flags.
/// `userId` has no FK (legacy) — authors are looked up defensively.
model Discussion {
  id            String             @id @default(uuid())
  /// SaaS tenant. null = legacy single-tenant data.
  institutionId String?
  courseId      String
  /// null / "" = course-wide.
  moduleId      String?
  userId        String
  title         String
  /// Sanitized rich-text HTML.
  body          String
  /// Comma-separated lower-case tags (each matches ^[a-z0-9-]+$, so commas never occur inside a tag).
  tags          String?
  /// "QUESTION" | "DISCUSSION" | "ANNOUNCEMENT" | "SHOWCASE" | "FEEDBACK".
  category      String             @default("DISCUSSION")
  /// Kept in sync with "has an accepted reply" for QUESTION threads.
  isResolved    Boolean            @default(false)
  isPinned      Boolean            @default(false)
  /// No new replies.
  isLocked      Boolean            @default(false)
  /// Hidden from students (moderation).
  isHidden      Boolean            @default(false)
  views         Int                @default(0)
  likes         Int                @default(0)
  createdAt     DateTime           @default(now())
  /// Last content edit or new reply (pin / lock / hide don't bump it), like the panel. null = never (legacy rows) → createdAt.
  updatedAt     DateTime?
  replies       DiscussionReply[]
  reports       DiscussionReport[]

  @@index([institutionId, courseId])
}

model DiscussionReply {
  id            String     @id @default(uuid())
  discussionId  String
  discussion    Discussion @relation(fields: [discussionId], references: [id])
  userId        String
  /// Sanitized rich-text HTML.
  body          String
  /// One level of nesting: always a top-level reply's id (or null).
  parentReplyId String?
  likes         Int        @default(0)
  /// Accepted answer (QUESTION threads, at most one per thread).
  isAccepted    Boolean    @default(false)
  /// Soft-removed by a moderator.
  isRemoved     Boolean    @default(false)
  createdAt     DateTime   @default(now())
  /// Last edit; null = never edited (legacy rows) → createdAt.
  updatedAt     DateTime?

  @@index([discussionId, createdAt])
}

/// A member's report on a thread or a reply (moderation queue).
model DiscussionReport {
  id             String     @id @default(uuid())
  institutionId  String?
  threadId       String
  thread         Discussion @relation(fields: [threadId], references: [id], onDelete: Cascade)
  /// "THREAD" | "REPLY".
  targetType     String
  /// Thread id, or the reply id when targetType = REPLY.
  targetId       String
  reporterId     String
  reporter       User       @relation("DiscussionReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  /// "SPAM" | "ABUSIVE" | "OFF_TOPIC" | "PLAGIARISM" | "OTHER".
  reason         String
  note           String     @default("")
  /// "OPEN" | "DISMISSED" | "ACTIONED".
  status         String     @default("OPEN")
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedById   String?
  createdAt      DateTime   @default(now())

  @@index([threadId, status])
  @@index([targetId])
  @@index([institutionId, status])
}

model CourseReview {
  id         String   @id @default(uuid())
  courseId   String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  reviewText String?
  status     String
  createdAt  DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([courseId, status])
  @@index([userId])
}

/// Issued certificate. First-version columns keep their names: verificationCode is the panel's public `code`
/// (new rows store the same "EDU-HTML-2026-00042" in certificateNumber), certificateUrl is "" for rows rendered client-side.
model Certificate {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id])
  certificateNumber String   @unique
  certificateUrl    String
  verificationCode  String   @unique
  issuedAt          DateTime @default(now())

  /// SaaS tenant. null = legacy single-tenant data.
  institutionId String?
  /// Template it was rendered with (null on legacy rows or when the template was removed).
  templateId    String?
  template      CertificateTemplate?   @relation(fields: [templateId], references: [id], onDelete: SetNull)
  /// Final grade % when the template shows grades.
  grade         Int?
  /// Course completion moment (null on legacy rows = issuedAt).
  completedAt   DateTime?
  /// null = never expires.
  expiresAt     DateTime?
  method        CertificateIssueMethod @default(AUTO)
  /// Stored status; EXPIRED is derived from expiresAt.
  status        CertificateStatus      @default(VALID)
  revokedReason String                 @default("")
  revokedAt     DateTime?
  downloads     Int                    @default(0)
  verifications Int                    @default(0)
  emailedAt     DateTime?
  events        CertificateEvent[]

  @@index([certificateNumber])
  @@index([verificationCode])
  @@index([institutionId, issuedAt])
  @@index([courseId, userId])
}

enum CertificateIssueMethod {
  AUTO
  MANUAL
}

enum CertificateStatus {
  VALID
  REVOKED
}

enum CertificateLayout {
  CLASSIC
  MODERN
  MINIMAL
}

enum CertificateOrientation {
  LANDSCAPE
  PORTRAIT
}

enum CertificateTemplateStatus {
  ACTIVE
  DRAFT
  ARCHIVED
}

/// Admin panel › Certificates › Templates (designer + issue rules).
model CertificateTemplate {
  id                 String                    @id @default(uuid())
  /// SaaS tenant. null = legacy single-tenant data.
  institutionId      String?
  name               String
  layout             CertificateLayout         @default(CLASSIC)
  orientation        CertificateOrientation    @default(LANDSCAPE)
  /// "orange" | "blue" | "green" | "purple" | "navy".
  accent             String                    @default("orange")
  heading            String
  /// Plain text with {placeholders}.
  bodyText           String
  showLogo           Boolean                   @default(true)
  showQr             Boolean                   @default(true)
  showGrade          Boolean                   @default(false)
  /// [{ id, name, title, signatureUrl }]
  signers            Json                      @default("[]")
  /// Courses using this template (a course is in at most one ACTIVE template per workspace).
  courseIds          String[]                  @default([])
  autoIssue          Boolean                   @default(false)
  minCompletion      Int                       @default(100)
  minQuizScore       Int?
  requireAssignments Boolean                   @default(false)
  validityMonths     Int?
  status             CertificateTemplateStatus @default(DRAFT)
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  certificates       Certificate[]

  @@index([institutionId, status])
}

enum CertificateEventKind {
  ISSUED
  EMAILED
  DOWNLOADED
  VERIFIED
  REVOKED
  RESTORED
  REISSUED
}

/// Certificate › Activity card.
model CertificateEvent {
  id            String               @id @default(uuid())
  certificateId String
  certificate   Certificate          @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  kind          CertificateEventKind
  message       String
  actorId       String?
  actorName     String
  createdAt     DateTime             @default(now())

  @@index([certificateId, createdAt])
}

// --- AI Engine ---
model AiTutorSession {
  id            String          @id @default(uuid())
  userId        String
  courseId      String
  lessonId      String
  title         String
  modelName     String
  createdAt     DateTime        @default(now())
  lastMessageAt DateTime
  messages      AiChatMessage[]
}

model AiChatMessage {
  id        String         @id @default(uuid())
  sessionId String
  session   AiTutorSession @relation(fields: [sessionId], references: [id])
  userId    String
  role      String
  message   String
  tokenUsed Int
  createdAt DateTime       @default(now())
}

model AiKnowledgeDocument {
  id         String   @id @default(uuid())
  courseId   String
  lessonId   String
  title      String
  content    String
  fileUrl    String?
  sourceType String
  status     String
  createdAt  DateTime @default(now())
}

model AiEmbedding {
  id              String   @id @default(uuid())
  documentId      String
  courseId        String
  chunkText       String
  embeddingVector String // Stores vector data
  metadata        String? // JSON string
  createdAt       DateTime @default(now())
}

model AiGeneratedContent {
  id                   String   @id @default(uuid())
  courseId             String
  lessonId             String
  type                 String
  prompt               String
  output               String
  reviewedByInstructor Boolean  @default(false)
  createdAt            DateTime @default(now())
}

model AiLearningRecommendation {
  id                 String   @id @default(uuid())
  userId             String
  courseId           String
  weakTopics         String
  recommendedLessons String
  recommendedCourses String
  reason             String
  createdAt          DateTime @default(now())
}

