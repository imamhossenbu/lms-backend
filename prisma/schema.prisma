}

// --- Communication ---
/// One in-app notification for one user (student inbox, admin inbox). Broadcast deliveries and template sends create these.
model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  /// Legacy free-form type; template sends store the trigger (e.g. "CERTIFICATE_ISSUED"), broadcasts "BROADCAST".
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  /// SaaS tenant of the recipient (null = legacy single-tenant data).
  institutionId String?
  /// ENROLLMENT | PAYMENT | SUBMISSION | COMMUNITY | LIVE_CLASS | CERTIFICATE | SYSTEM
  category      String    @default("SYSTEM")
  /// NORMAL | HIGH
  priority      String    @default("NORMAL")
  /// In-app link to the related page ("" = none).
  href          String    @default("")
  isArchived    Boolean   @default(false)
  readAt        DateTime?
  /// Set when this row was created by a broadcast (Announcement).
  broadcastId   String?

  @@index([userId, isRead])
  @@index([broadcastId])
}

/// Automated notification template — one per trigger per institution (slug = "<institutionId|default>:<trigger-slug>").
model NotificationTemplate {
  id      String @id @default(uuid())
  slug    String @unique
  /// Subject / in-app title with {placeholders}.
  title   String
  /// Body with {placeholders} (plain text with line breaks).
  message String
  type    String

  institutionId String?
  /// TemplateTrigger (null on legacy rows).
  trigger       String?
  name          String   @default("")
  /// IN_APP | EMAIL | PUSH
  channels      String[] @default(["IN_APP"])
  enabled       Boolean  @default(true)
  /// Security emails (password reset) can't be disabled.
  locked        Boolean  @default(false)
  updatedAt     DateTime @default(now()) @updatedAt

  @@index([institutionId, trigger])
}

/// Admin broadcast (panel "Broadcast"). Legacy rows are per-course announcements (courseId + message).
model Announcement {
  id         String   @id @default(uuid())
  /// Legacy single course; "" for broadcasts that don't target exactly one course (see courseIds).
  courseId   String
  /// User id of the author.
  createdBy  String
  title      String
  /// Plain-text copy of the message (legacy readers); messageHtml is the rich source.
  message    String
  targetRole String
  createdAt  DateTime @default(now())

  institutionId  String?
  messageHtml    String    @default("")
  /// ALL_STUDENTS | COURSE | INSTRUCTORS | INACTIVE_STUDENTS
  audience       String    @default("COURSE")
  courseIds      String[]  @default([])
  /// IN_APP | EMAIL | PUSH
  channels       String[]  @default(["IN_APP"])
  priority       String    @default("NORMAL")
  ctaLabel       String    @default("")
  ctaUrl         String    @default("")
  /// SENT | SCHEDULED | DRAFT | CANCELLED (legacy rows = SENT)
  status         String    @default("SENT")
  /// When it was / will be sent (null for drafts without a time).
  sendAt         DateTime?
  recipientCount Int       @default(0)
  updatedAt      DateTime  @default(now()) @updatedAt

  deliveries NotificationDelivery[]

  @@index([institutionId, status])
  @@index([status, sendAt])
}

/// One recipient × channel row of a sent broadcast (panel "BroadcastDelivery").
model NotificationDelivery {
  id             String       @id @default(uuid())
  broadcastId    String
  broadcast      Announcement @relation(fields: [broadcastId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// IN_APP | EMAIL | PUSH
  channel        String
  /// DELIVERED | OPENED | CLICKED | FAILED
  status         String
  error          String       @default("")
  /// The in-app Notification row (IN_APP channel) — reading / clicking it updates this delivery.
  notificationId String?
  deliveredAt    DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  createdAt      DateTime     @default(now())

  @@unique([broadcastId, userId, channel])
  @@index([notificationId])
  @@index([userId])
}

// --- Payments & Settings ---
model Coupon {
  id                String   @id @default(uuid())
  code              String
  /// Tenant (null = legacy single-tenant workspace). Codes are unique per workspace.
  institutionId     String?
  discountType      String
  discountTypeValue Decimal
  courseId          String
  maxUses           Int
  usedCount         Int      @default(0)
  startDate         DateTime
  endDate           DateTime
  status            String
  createdAt         DateTime @default(now())

  orders Order[]

  @@unique([institutionId, code])
  @@index([institutionId])
}

model CouponUsage {
  id             String   @id @default(uuid())
  couponId       String
  userId         String
  orderId        String
  discountAmount Decimal
  usedAt         DateTime @default(now())
}

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique
  userId      String
  user        User   @relation(fields: [userId], references: [id])
  courseId    String

  course Course @relation(fields: [courseId], references: [id])

  amount         Decimal
  discountAmount Decimal
  taxAmount      Decimal
  totalAmount    Decimal
  currency       String
  status         String
  couponId       String?
  coupon         Coupon?  @relation(fields: [couponId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // payment details (admin panel › Orders / Payments)
  /// "SSLCommerz" | "bKash" | "Nagad" | "Stripe" | "PayPal"
  paymentMethod  String?
  /// Masked account, e.g. "Visa **** 4242".
  paymentAccount String?
  /// Gateway transaction / manual reference.
  transactionId  String?
  paidAt         DateTime?
  manuallyPaid   Boolean   @default(false)
  cancelReason   String?
  refundReason   String?
  refundedAt     DateTime?
  receiptSentAt  DateTime?
  ipAddress      String?
  device         String?
  referralSource String    @default("Direct")
  notes          String?

  events     OrderEvent[]
  orderNotes OrderNote[]
  payments   Payment[]

  @@index([courseId, status])
  @@index([userId])
  @@index([status, createdAt])
}

model Payment {
  id                    String    @id @default(uuid())
  orderId               String
  order                 Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  userId                String
  courseId              String
  provider              String
  providerTransactionId String
  amount                Decimal
  currency              String
  status                String
  gatewayResponse       String
  paidAt                DateTime?
  createdAt             DateTime  @default(now())

  @@index([orderId])
}

model Invoice {
  id             String   @id @default(uuid())
  invoiceNumber  String   @unique
  orderId        String
  userId         String
  courseId       String
  amount         Decimal
  discountAmount Decimal
  taxAmount      Decimal
  totalAmount    Decimal
  currency       String
  invoiceUrl     String
  issuedAt       DateTime @default(now())
}

// --- Logs & System ---
/// Live class. First-version columns keep their names: description (descriptionHtml), meetingUrl (meetingLink),
/// startTime/endTime (instants; the panel sends a workspace-local date + "HH:mm" times).
/// status: "ACTIVE" | "CANCELLED" (legacy "SCHEDULED"/"COMPLETED" read as ACTIVE) — LIVE/UPCOMING/… are derived from the clock.
model LiveClass {
  id                 String    @id @default(uuid())
  /// SaaS tenant. null = legacy single-tenant data.
  institutionId      String?
  courseId           String
  course             Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructorId       String
  instructor         User      @relation("LiveClassInstructor", fields: [instructorId], references: [id])
  title              String
  description        String?
  meetingUrl         String
  startTime          DateTime
  endTime            DateTime
  recordingUrl       String?
  status             String
  /// "INTERACTIVE" | "WEBINAR" | "WORKSHOP" | "QA".
  type               String    @default("INTERACTIVE")
  /// "ZOOM" | "GOOGLE_MEET" | "TEAMS" | "CUSTOM".
  platform           String    @default("CUSTOM")
  meetingId          String    @default("")
  passcode           String    @default("")
  sendLinkToStudents Boolean   @default(true)
  /// Max seats; 0 = every enrolled student.
  capacity           Int       @default(0)
  /// { allowQa, enableChat, recordClass, makePublic, sendReminder, autoAttendance }
  settings           Json      @default("{}")
  /// Minutes before start: "NONE" | "5" | "15" | "30" | "60" | "1440".
  reminder           String    @default("NONE")
  reminderSentAt     DateTime?
  thumbnailUrl       String    @default("")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @default(now()) @updatedAt

  attendances Attendance[]
  questions   LiveQuestion[]
  resources   LiveResource[]
  events      LiveClassEvent[]

  @@index([instructorId, startTime])
  @@index([courseId])
  @@index([institutionId, startTime])
}

/// One row per student who joined, confirmed (RSVP) or was marked by an admin.
/// status: "ACTIVE" (in the room) | "COMPLETED" (left) | "SUSPENDED" | "ATTENDED" (marked) → Attended;
///         "ABSENT" (marked) → Absent; "RSVP" → Absent once the class has ended.
model Attendance {
  id              String    @id @default(uuid())
  liveClassId     String
  liveClass       LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  userId          String
  /// null = never joined (RSVP / marked absent).
  joinedAt        DateTime?
  leftAt          DateTime?
  durationMinutes Int
  status          String
  createdAt       DateTime  @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, liveClassId])
  @@index([liveClassId])
}

/// Q&A tab: a student's question during a class.
model LiveQuestion {
  id           String    @id @default(uuid())
  liveClassId  String
  liveClass    LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  question     String
  /// "PENDING" | "ANSWERED".
  status       String    @default("PENDING")
  answerHtml   String    @default("")
  answeredById String?
  answeredAt   DateTime?
  createdAt    DateTime  @default(now())

  @@index([liveClassId, createdAt])
}

/// Resources tab: recordings, documents, links, code shared with the class.
model LiveResource {
  id          String    @id @default(uuid())
  liveClassId String
  liveClass   LiveClass @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  /// "RECORDING" | "DOCUMENT" | "LINK" | "CODE".
  type        String
  title       String
  description String    @default("")
  url         String
  /// Bytes; 0 for links.
  size        Int       @default(0)
  /// "ALL_STUDENTS" | "ATTENDEES" | "HIDDEN".
  visibility  String    @default("ALL_STUDENTS")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @default(now()) @updatedAt

  @@index([liveClassId])
}

enum LiveClassEventKind {
  CLASS_STARTED
  STUDENTS_JOINED
  QUESTION_ASKED
  QUESTION_ANSWERED
  SCREEN_SHARED
  RESOURCE_SHARED
  CLASS_ENDED
  CLASS_SCHEDULED
  CLASS_UPDATED
  CLASS_CANCELLED
}

/// Activity tab.
model LiveClassEvent {
  id          String             @id @default(uuid())
  liveClassId String
  liveClass   LiveClass          @relation(fields: [liveClassId], references: [id], onDelete: Cascade)
  kind        LiveClassEventKind
  title       String
  detail      String
  actorName   String
  /// Question / resource id the entry points at.
  refId       String?
  createdAt   DateTime           @default(now())

  @@index([liveClassId, createdAt])
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String
  ipAddress  String
  userAgent  String
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Setting {
  id String @id @default(uuid())

  siteName        String
  logo            String?
  favicon         String?
  defaultLanguage String  @default("bn")

  allowRegistration  Boolean @default(true)
  certificateEnabled Boolean @default(true)
  aiEnabled          Boolean @default(false)
  maintenanceMode    Boolean @default(false)

  primaryColor   String @default("#2563eb")
  secondaryColor String @default("#64748b")
  accentColor    String @default("#f59e0b")

  backgroundColor String @default("#ffffff")
  surfaceColor    String @default("#f8fafc")
  textColor       String @default("#1e293b")
  textMutedColor  String @default("#64748b")

  headerBackgroundColor String @default("#ffffff")
  headerTextColor       String @default("#1e293b")
  footerBackgroundColor String @default("#1e293b")
  footerTextColor       String @default("#ffffff")

  supportEmail String?
  contactPhone String?
  facebookUrl  String?
  youtubeUrl   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}

/// Admin panel › Settings — one row per workspace. Each section is stored as JSON in the panel's shape
/// (src/workspace-settings/workspace-settings.types.ts); null = never saved → defaults. Secrets never live in
/// the section JSON: they are AES-GCM encrypted in `secrets`.
model WorkspaceSettings {
  id               String   @id @default(uuid())
  /// Tenant (null = legacy single-tenant workspace).
  institutionId    String?
  /// institutionId ?? "legacy" — makes "one row per workspace" enforceable (NULLs aren't unique).
  scopeKey         String   @unique
  general          Json?
  branding         Json?
  learning         Json?
  payments         Json?
  email            Json?
  security         Json?
  integrations     Json?
  maintenance      Json?
  /// "payments.stripe.secretKey" → { cipher: "v1.…", hint: "••••4e19" }.
  secrets          Json     @default("{}")
  /// Section → last saved ISO time.
  sectionUpdatedAt Json     @default("{}")
  /// Latest 50 changes: { id, section, summary, actor, at }.
  audit            Json     @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([institutionId])
  @@map("workspace_settings")
}

// =====================================================================
// --- SaaS layer (multi-tenant subscriptions) ---
// Mirrors the frontend contract in lms-admin-panel/src/types/saas.ts.
// =====================================================================

enum SaasBillingCycle {
  MONTHLY
  YEARLY
}

enum SaasSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum SaasInvoiceStatus {
  PAID
  OPEN
  FAILED
  REFUNDED
  VOID
}

enum CustomDomainStatus {
  PENDING_DNS
  VERIFIED
  FAILED
}

enum InstitutionType {
  SCHOOL
  COACHING
  UNIVERSITY
  COMPANY
  CREATOR
}

enum InstitutionSource {
  SELF_SIGNUP
  OWNER_CREATED
}

enum SaasEventType {
  SIGNED_UP
  TRIAL_STARTED
  TRIAL_CONVERTED
  TRIAL_EXPIRED
  PLAN_UPGRADED
  PLAN_DOWNGRADED
  CYCLE_CHANGED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  CANCELLED
  REACTIVATED
  SUSPENDED
  DOMAIN_ADDED
  DOMAIN_VERIFIED
  NOTE
}

enum SaasActor {
  Owner
  Institution
  System
}

/// A pricing plan: built-in tiers ("starter" … "enterprise") or owner-created custom plans ("plan-<slug>").
model SaasPlan {
  id               String   @id
  name             String   @unique
  tagline          String
  /// USD per month. 0 = custom pricing ("Contact sales").
  priceMonthly     Decimal  @db.Decimal(12, 2)
  /// USD per year. 0 = custom pricing.
  priceYearly      Decimal  @db.Decimal(12, 2)
  /// Limits — null = unlimited.
  limitStudents    Int?
  limitCourses     Int?
  limitTeamMembers Int?
  limitStorageGb   Int?
  features         String[]
  highlighted      Boolean  @default(false)
  isPublic         Boolean  @default(true)
  trialDays        Int      @default(14)
  archived         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  institutions Institution[]
  invoices     SaasInvoice[]

  @@map("saas_plans")
}

/// One tenant. Carries exactly one subscription (flattened `sub*` columns).
model Institution {
  id           String            @id @default(uuid())
  name         String
  slug         String            @unique
  logoInitials String
  tone         String            @default("orange")
  type         InstitutionType
  country      String
  ownerName    String
  ownerEmail   String
  phone        String            @default("")
  notes        String            @default("")
  source       InstitutionSource @default(OWNER_CREATED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  lastActiveAt DateTime          @default(now())

  // usage counters (kept in sync by the LMS modules once tenancy is wired)
  usageStudents    Int   @default(0)
  usageCourses     Int   @default(0)
  usageTeamMembers Int   @default(1)
  usageStorageGb   Float @default(0)

  // subscription
  planId              String
  plan                SaasPlan                @relation(fields: [planId], references: [id])
  cycle               SaasBillingCycle        @default(MONTHLY)
  status              SaasSubscriptionStatus
  startedAt           DateTime                @default(now())
  trialEndsAt         DateTime?
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  cancelAtPeriodEnd   Boolean                 @default(false)
  cancelledAt         DateTime?
  suspendedAt         DateTime?
  suspendedReason     String?
  statusBeforeSuspend SaasSubscriptionStatus?
  /// Negotiated price PER BILLING CYCLE — overrides the plan price when set.
  customPrice         Decimal?                @db.Decimal(12, 2)
  paymentBrand        String?
  paymentLast4        String?

  customDomain          CustomDomain?
  invoices              SaasInvoice[]
  events                SaasEvent[]
  users                 User[]
  couponRedemptions     SaasCouponRedemption[]
  academySite           AcademySite?
  newsletterSubscribers NewsletterSubscriber[]
  contactMessages       AcademyContactMessage[]

  @@index([status])
  @@index([planId])
  @@index([ownerEmail])
  @@map("institutions")
}

model CustomDomain {
  id            String             @id @default(uuid())
  institutionId String             @unique
  institution   Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  domain        String             @unique
  status        CustomDomainStatus @default(PENDING_DNS)
  addedAt       DateTime           @default(now())
  verifiedAt    DateTime?
  dnsTarget     String
  txtToken      String
  lastCheckedAt DateTime?

  @@map("custom_domains")
}

model SaasInvoice {
  id                 String                @id @default(uuid())
  /// e.g. "EDP-2026-00123"
  number             String                @unique
  institutionId      String
  institution        Institution           @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  planId             String
  plan               SaasPlan              @relation(fields: [planId], references: [id])
  cycle              SaasBillingCycle
  amount             Decimal               @db.Decimal(12, 2)
  tax                Decimal               @db.Decimal(12, 2)
  total              Decimal               @db.Decimal(12, 2)
  status             SaasInvoiceStatus
  issuedAt           DateTime              @default(now())
  dueAt              DateTime
  paidAt             DateTime?
  periodStart        DateTime
  periodEnd          DateTime
  description        String?
  /// Coupon discount on `amount` (pre-tax). total = amount − discount + tax.
  discount           Decimal               @default(0) @db.Decimal(12, 2)
  couponCode         String?
  couponRedemptionId String?
  couponRedemption   SaasCouponRedemption? @relation(fields: [couponRedemptionId], references: [id], onDelete: SetNull)

  @@index([institutionId, status])
  @@index([status])
  @@index([issuedAt])
  @@map("saas_invoices")
}

/// Per-institution lifecycle timeline.
model SaasEvent {
  id            String        @id @default(uuid())
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  type          SaasEventType
  message       String
  actor         SaasActor     @default(Owner)
  at            DateTime      @default(now())

  @@index([institutionId, at])
  @@index([at])
  @@map("saas_events")
}

/// Atomic counters (e.g. invoice numbers per year: key "invoice-2026").
model SaasCounter {
  key   String @id
  value Int    @default(0)

  @@map("saas_counters")
}

// --- Owner Console extras: platform coupons, alert read-state, console settings ---

enum SaasCouponType {
  PERCENT
  FIXED
}

/// ONCE = first invoice only · REPEATING = invoices in the first `durationMonths` months · FOREVER = every invoice.
enum SaasCouponDuration {
  ONCE
  REPEATING
  FOREVER
}

enum SaasCouponCycle {
  ANY
  MONTHLY
  YEARLY
}

/// Discount codes on SaaS subscriptions (Owner Console › Coupons). Not the course `Coupon`.
model SaasCoupon {
  id               String             @id @default(uuid())
  /// Upper-case, unique, e.g. "LAUNCH20".
  code             String             @unique
  description      String             @default("")
  type             SaasCouponType
  /// Percent (1–100) or USD off per invoice.
  value            Decimal            @db.Decimal(12, 2)
  duration         SaasCouponDuration
  durationMonths   Int?
  /// Plans it applies to; empty = every plan.
  planIds          String[]
  cycle            SaasCouponCycle    @default(ANY)
  /// null = unlimited.
  maxRedemptions   Int?
  /// Last moment it can be redeemed; null = never expires.
  expiresAt        DateTime?
  newCustomersOnly Boolean            @default(false)
  active           Boolean            @default(true)
  createdById      String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  redemptions SaasCouponRedemption[]

  @@index([active])
  @@map("saas_coupons")
}

/// One institution redeeming one coupon (at most once per coupon). Discounts its invoices while running.
model SaasCouponRedemption {
  id              String           @id @default(uuid())
  couponId        String
  coupon          SaasCoupon       @relation(fields: [couponId], references: [id], onDelete: Restrict)
  institutionId   String
  institution     Institution      @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  planId          String
  cycle           SaasBillingCycle
  at              DateTime         @default(now())
  /// Total discount granted so far (USD).
  amountOff       Decimal          @default(0) @db.Decimal(12, 2)
  invoicesApplied Int              @default(0)
  /// REPEATING: set on the first discounted invoice (+ durationMonths).
  discountEndsAt  DateTime?
  /// Set once the discount is used up (ONCE) or removed.
  endedAt         DateTime?

  invoices SaasInvoice[]

  @@unique([couponId, institutionId])
  @@index([institutionId])
  @@map("saas_coupon_redemptions")
}

/// Owner Console alert read-state (alerts are derived live; ids like "<institutionId>-pastdue").
model ConsoleAlertRead {
  id      String   @id @default(uuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  alertId String
  readAt  DateTime @default(now())

  @@unique([userId, alertId])
  @@map("console_alert_reads")
}

/// Owner Console › Settings — a single platform row (id "platform"). Sections are JSON merged over defaults.
model ConsoleSettings {
  id               String   @id @default("platform")
  company          Json?
  billing          Json?
  trials           Json?
  email            Json?
  /// "billing.stripe.secretKey" → { cipher: "v1.…", hint: "••••4e19" }.
  secrets          Json     @default("{}")
  /// Section → last saved ISO time.
  sectionUpdatedAt Json     @default("{}")
  updatedById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("console_settings")
}

// --- Student notes (admin panel › Student details › Notes) ---
enum StudentNoteCategory {
  GOOD_PROGRESS
  NEEDS_IMPROVEMENT
  STUDENT_SUPPORT
  COUNSELING_CALL
  PAYMENT_ISSUE
  GENERAL
}

model StudentNote {
  id        String              @id @default(uuid())
  studentId String
  student   User                @relation("NoteStudent", fields: [studentId], references: [id], onDelete: Cascade)
  authorId  String
  author    User                @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  category  StudentNoteCategory @default(GENERAL)
  content   String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([studentId, createdAt])
  @@map("student_notes")
}

// --- Instructor notes (admin panel › Instructor details › Notes) ---
enum InstructorNoteType {
  GENERAL
  PERFORMANCE
  CONTENT_UPDATE
  ONBOARDING
  MEETING
  ISSUE
  PAYMENT
}

enum NotePriority {
  LOW
  MEDIUM
  HIGH
}

model InstructorNote {
  id           String             @id @default(uuid())
  instructorId String
  instructor   User               @relation("InstructorNoteInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  authorId     String
  author       User               @relation("InstructorNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title        String
  /// Sanitized HTML from the rich text editor.
  content      String
  type         InstructorNoteType @default(GENERAL)
  priority     NotePriority       @default(MEDIUM)
  tags         String[]
  /// Calendar date of the reminder (no time).
  reminderDate DateTime?          @db.Date
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([instructorId, createdAt])
  @@map("instructor_notes")
}

// =====================================================================
// --- Team & Roles (admin-panel staff RBAC) ---
// Mirrors lms-admin-panel src/types/team.ts. Permissions are JSON maps
// { [module]: action[] } validated by src/team/team-permissions.ts.
// =====================================================================

enum TeamMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum TeamEventType {
  INVITED
  INVITE_RESENT
  INVITE_REVOKED
  JOINED
  ROLE_CHANGED
  SUSPENDED
  REACTIVATED
  REMOVED
  TWO_FA_ENABLED
  TWO_FA_RESET
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_RESET
  ROLE_DELETED
  EXTRA_PERMISSIONS_GRANTED
  EXTRA_PERMISSIONS_REMOVED
}

model TeamRole {
  id                 String   @id @default(uuid())
  /// Tenant (null = legacy single-tenant workspace).
  institutionId      String?
  /// Built-in role key ("super-admin", "admin", "content", "support", "finance"); null for custom roles.
  systemKey          String?
  name               String
  description        String   @default("")
  tone               String   @default("gray")
  isSystem           Boolean  @default(false)
  isLocked           Boolean  @default(false)
  permissions        Json
  /// System roles: shipped preset for "Reset to default". null for custom roles.
  defaultPermissions Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members TeamMember[]

  @@index([institutionId])
  @@map("team_roles")
}

model TeamMember {
  id               String           @id @default(uuid())
  institutionId    String?
  /// Set once the invitation is accepted (or for the workspace owner).
  userId           String?          @unique
  user             User?            @relation("TeamMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  email            String
  roleId           String
  role             TeamRole         @relation(fields: [roleId], references: [id])
  /// Additive grants on top of the role (never repeats a role permission).
  extraPermissions Json
  status           TeamMemberStatus
  isOwner          Boolean          @default(false)
  joinedAt         DateTime?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // invitation (while status = INVITED)
  /// SHA-256 of the invitation token — the raw token is only ever in the email link.
  inviteTokenHash   String?   @unique
  inviteSentAt      DateTime?
  inviteExpiresAt   DateTime?
  inviteMessage     String?
  invitedById       String?
  invitedBy         User?     @relation("TeamMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  inviteResentCount Int       @default(0)

  @@index([institutionId, status])
  @@index([institutionId, email])
  @@map("team_members")
}

model TeamEvent {
  id            String        @id @default(uuid())
  institutionId String?
  type          TeamEventType
  actorId       String?
  actorName     String
  /// Member or role the event is about (null once it was deleted).
  targetId      String?
  targetName    String
  detail        String        @default("")
  at            DateTime      @default(now())

  @@index([institutionId, at])
  @@map("team_events")
}

// --- Order timeline + internal notes (admin panel › Orders / Payments) ---
enum OrderEventType {
  ORDER_PLACED
  PAYMENT_COMPLETED
  PAYMENT_VERIFIED
  MARKED_AS_PAID
  ENROLLMENT_CREATED
  COURSE_ACCESS_GRANTED
  PAYMENT_FAILED
  ORDER_CANCELLED
  ORDER_REOPENED
  REFUND_ISSUED
  COURSE_ACCESS_REVOKED
}

model OrderEvent {
  id        String         @id @default(uuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type      OrderEventType
  at        DateTime       @default(now())
  /// Who did it ("System" for gateway callbacks).
  actorName String?
  note      String?

  @@index([orderId, at])
  @@map("order_events")
}

enum OrderNoteScope {
  ORDER
  PAYMENT
}

model OrderNote {
  id        String         @id @default(uuid())
  orderId   String
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  scope     OrderNoteScope
  authorId  String
  author    User           @relation("OrderNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([orderId, scope, createdAt])
  @@map("order_notes")
}

/// Settings › Maintenance › Backups: a gzipped JSON snapshot of one workspace's data (passwords, secrets and
/// tokens removed). AUTO = the nightly job, MANUAL = "Back up now". Deleted after `expiresAt` (retention).
model WorkspaceBackup {
  id            String   @id @default(uuid())
  /// Tenant (null = legacy single-tenant workspace).
  institutionId String?
  kind          String
  /// gzip(JSON) — never selected by default (global omit in PrismaService).
  data          Bytes
  sizeBytes     Int
  /// Rows per table, e.g. { "Course": 12, "User": 340 }.
  tableCounts   Json     @default("{}")
  createdByName String   @default("")
  createdAt     DateTime @default(now())
  expiresAt     DateTime

  @@index([institutionId, createdAt])
  @@map("workspace_backups")
}

/// Marketing website › Contact form: a demo / sales / support request from a visitor. The platform owner is
/// emailed for each one; NEW until handled.
model MarketingLead {
  id              String   @id @default(uuid())
  name            String
  email           String
  phone           String   @default("")
  institutionName String   @default("")
  /// Rough size, e.g. "1-100" / "101-500" / "501-2000" / "2000+".
  studentCount    String   @default("")
  /// DEMO | SALES | SUPPORT | PARTNERSHIP | OTHER
  topic           String
  message         String
  status          String   @default("NEW")
  ip              String   @default("")
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@map("marketing_leads")
}

/// Marketing website › testimonials, managed by the platform owner in the Owner Console. Only published
/// ones are served (GET /saas/public/testimonials), in `order`.
model Testimonial {
  id          String   @id @default(uuid())
  quote       String
  name        String
  /// e.g. "Director, LearnZone Academy".
  role        String   @default("")
  /// Optional photo URL (uploaded via the console); initials are shown without one.
  avatarUrl   String   @default("")
  isPublished Boolean  @default(false)
  /// Shown as the highlighted (orange) card.
  featured    Boolean  @default(false)
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished, order])
  @@map("testimonials")
}

/// Marketing website blog post, written by the platform owner in the Owner Console › Blog.
model BlogPost {
  id              String    @id @default(uuid())
  /// URL part: /blog/{slug}. Unique, lowercase, hyphenated.
  slug            String    @unique
  title           String
  /// One or two sentences for cards and search results.
  excerpt         String
  /// Article body in Markdown (headings, lists, links, images, quotes, code).
  content         String
  /// Optional cover image (https); the website draws a branded cover without one.
  coverUrl        String    @default("")
  category        String    @default("Guides")
  tags            String[]  @default([])
  authorName      String    @default("EduPro Team")
  authorRole      String    @default("")
  authorAvatarUrl String    @default("")
  /// Estimated from the word count on save.
  readMinutes     Int       @default(1)
  isPublished     Boolean   @default(false)
  /// Shown as the large post at the top of /blog.
  featured        Boolean   @default(false)
  /// Set the first time the post is published.
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([isPublished, publishedAt])
  @@index([category])
  @@map("blog_posts")
}

/// A plan purchase started on the marketing website's /checkout and paid through SSLCommerz. The academy and its
/// admin are created only after the gateway payment is validated server-to-server.
model SaasCheckout {
  id              String    @id @default(uuid())
  /// Our reference sent to the gateway as tran_id (also the public lookup key for the result page).
  tranId          String    @unique
  planId          String
  cycle           String
  /// Charged amounts (USD): plan price + tax for the chosen country.
  subtotal        Float
  tax             Float
  total           Float
  currency        String    @default("USD")
  /// PENDING → PAID | FAILED | CANCELLED
  status          String    @default("PENDING")
  /// Sign-up details (password stored as a bcrypt hash only).
  name            String
  email           String
  phone           String    @default("")
  passwordHash    String
  institutionName String
  institutionType String
  country         String
  slug            String
  /// Set once the academy is created after a validated payment.
  institutionId   String?
  /// Gateway details from the validation API.
  valId           String    @default("")
  bankTranId      String    @default("")
  cardType        String    @default("")
  /// Why it failed (shown on the result page).
  error           String    @default("")
  paidAt          DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("saas_checkouts")
}

/// Content of an academy's public website (lms-academy-site) that the admin edits: hero text, mission,
/// mobile app links, FAQ, social links, newsletter copy. Shape: src/academy-site/academy-site.types.ts AcademySiteContent.
model AcademySite {
  id            String      @id @default(uuid())
  institutionId String      @unique
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  content       Json
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@map("academy_sites")
}

/// Newsletter sign-ups from an academy's website (one row per email per academy).
model NewsletterSubscriber {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  email         String
  name          String      @default("")
  /// SUBSCRIBED | UNSUBSCRIBED
  status        String      @default("SUBSCRIBED")
  /// Where the form was: "home" | "footer" | …
  source        String      @default("website")
  ip            String      @default("")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([institutionId, email])
  @@index([institutionId, createdAt])
  @@map("newsletter_subscribers")
}

/// Contact-form messages from an academy's website (Admin panel › Website › Messages).
model AcademyContactMessage {
  id            String      @id @default(uuid())
  institutionId String
  institution   Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  name          String
  email         String
  phone         String      @default("")
  /// COURSE | ENROLLMENT | PAYMENT | TECHNICAL | OTHER
  topic         String
  message       String
  /// NEW | READ | REPLIED | ARCHIVED
  status        String      @default("NEW")
  ip            String      @default("")
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([institutionId, status, createdAt])
  @@map("academy_contact_messages")
}
