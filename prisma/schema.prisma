generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// --- User Management ---
model User {
  id                String    @id @default(uuid())
  name              String
  email             String    @unique
  password          String
  phone             String?
  avatar            String?
  role              String    @default("STUDENT")
  status            String    @default("PENDING")
  verificationToken String?   @unique
  lastLoginAt       DateTime?

  bio           String?
  education     String?
  skills        String?
  interests     String?
  country       String?
  language      String?
  socialLinks   String?
  address       String?
  /// Professional title shown on instructor profiles, e.g. "Senior Web Developer".
  headline      String?
  /// Main subject area, e.g. "Web Development".
  expertise     String?
  certificates  Certificate[]
  attendances   Attendance[]

  enrollments      Enrollment[]
  quizAttempts     QuizAttempt[]
  submissions      AssignmentSubmission[]
  lessonProgress   LessonProgress[]
  coursesTeaching  Course[]        @relation("CourseInstructor")
  notesAbout       StudentNote[]   @relation("NoteStudent")
  notesAuthored    StudentNote[]   @relation("NoteAuthor")
  instructorNotesAbout    InstructorNote[] @relation("InstructorNoteInstructor")
  instructorNotesAuthored InstructorNote[] @relation("InstructorNoteAuthor")
  reviews          CourseReview[]
  orders           Order[]
  liveClassesTaught LiveClass[]    @relation("LiveClassInstructor")
  /// Soft delete — hidden from lists and blocked from login.
  deletedAt        DateTime?
  lastLoginIp      String?

  // Two-factor authentication (TOTP). The secret is AES-256-GCM encrypted (common/crypto.ts).
  twoFactorEnabled   Boolean   @default(false)
  twoFactorSecret    String?
  twoFactorEnabledAt DateTime?

  teamMembership   TeamMember?     @relation("TeamMemberUser")
  teamInvitesSent  TeamMember[]    @relation("TeamMemberInviter")
  emailVerified Boolean       @default(false)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // SaaS tenant this user belongs to (null for the platform owner / legacy users)
  institutionId String?
  institution   Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)

  @@index([institutionId])
}

// --- Courses & Learning ---
model Category {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  status      String
  courses     Course[]
}

model Course {
  id               String   @id @default(uuid())
  title            String
  slug             String   @unique
  description      String
  shortDescription String
  thumbnail        String?
  categoryId       String
  category         Category @relation(fields: [categoryId], references: [id])
  instructorId     String
  instructor       User     @relation("CourseInstructor", fields: [instructorId], references: [id])
  level            String
  language         String
  price            Decimal
  isFree           Boolean  @default(false)
  status           String
  durationMinutes  Int
  requirements     String?
  learningOutcomes String?
  tags             String?
  ratingAverage    Decimal  @default(0)
  totalStudents    Int      @default(0)

  certificates Certificate[]
  reviews      CourseReview[]
  orders       Order[]
  modules      CourseModule[]
  enrollments    Enrollment[]
  quizzes        Quiz[]
  assignments    Assignment[]
  lessonProgress LessonProgress[]
  liveClasses    LiveClass[]

  @@index([instructorId])
}

model CourseModule {
  id              String   @id @default(uuid())
  courseId        String
  course          Course   @relation(fields: [courseId], references: [id])
  title           String
  description     String?
  order           Int
  isLocked        Boolean  @default(true)
  createdAt       DateTime @default(now())
  durationMinutes Int      @default(0)

  lessons Lesson[]
}

model Lesson {
  id       String       @id @default(uuid())
  courseId String
  moduleId String
  module   CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  title           String
  type            String
  content         String?
  videoUrl        String?
  durationMinutes Int
  order           Int
  isPreview       Boolean          @default(false)
  resources       String?
  status          String
  lessonResources LessonResource[]
  progress        LessonProgress[]
}

model LessonResource {
  id             String  @id @default(uuid())
  lessonId       String
  lesson         Lesson  @relation(fields: [lessonId], references: [id])
  title          String
  fileUrl        String
  fileType       String
  size           String
  isDownloadable Boolean @default(true)
}

model Enrollment {
  id                 String    @id @default(uuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId           String
  course             Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  enrolledAt         DateTime  @default(now())
  status             String
  progressPercentage Int       @default(0)
  completedAt        DateTime?
  lastAccessedAt     DateTime?

  @@unique([userId, courseId])
  @@index([courseId])
}

// --- Assessments ---
model LessonProgress {
  id             String    @id @default(uuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId       String
  course         Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId       String
  lesson         Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  isCompleted    Boolean   @default(false)
  watchedSeconds Int       @default(0)
  lastPosition   Int       @default(0)
  completedAt    DateTime?

  @@unique([userId, lessonId])
  @@index([userId, courseId])
}

model Quiz {
  id               String  @id @default(uuid())
  courseId         String
  course           Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId         String
  title            String
  description      String?
  timeLimitMinutes Int
  passingScore     Int
  totalMarks       Int
  status           String

  attempts QuizAttempt[]

  @@index([courseId])
}

model QuizQuestion {
  id            String  @id @default(uuid())
  quizId        String
  questionText  String
  questionType  String
  options       String
  correctAnswer String
  marks         Int
  explanation   String?
  order         Int
}

model QuizAttempt {
  id          String   @id @default(uuid())
  quizId      String
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers     String // JSON string
  score       Int
  percentage  Decimal
  parsed      Boolean
  startedAt   DateTime @default(now())
  submittedAt DateTime

  @@index([userId])
  @@index([quizId])
}

model Assignment {
  id               String   @id @default(uuid())
  courseId         String
  course           Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lessonId         String
  title            String
  description      String?
  dueDate          DateTime
  marks            Int
  allowedFileTypes String
  status           String

  submissions AssignmentSubmission[]

  @@index([courseId])
}

model AssignmentSubmission {
  id            String     @id @default(uuid())
  assignmentId  String
  assignment    Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileUrl       String?
  textAnswer    String?
  submittedAt   DateTime   @default(now())
  marksObtained Int?
  feedback      String?
  aiFeedback    String?
  status        String

  @@index([userId])
  @@index([assignmentId])
}

// --- Community ---
model Discussion {
  id         String            @id @default(uuid())
  courseId   String
  userId     String
  title      String
  body       String
  tags       String?
  isResolved Boolean           @default(false)
  createdAt  DateTime          @default(now())
  replies    DiscussionReply[]
}

model DiscussionReply {
  id            String     @id @default(uuid())
  discussionId  String
  discussion    Discussion @relation(fields: [discussionId], references: [id])
  userId        String
  body          String
  parentReplyId String?
  createdAt     DateTime   @default(now())
}

model CourseReview {
  id         String   @id @default(uuid())
  courseId   String
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating     Int
  reviewText String?
  status     String
  createdAt  DateTime @default(now())
  course     Course   @relation(fields: [courseId], references: [id])

  @@index([courseId, status])
  @@index([userId])
}

model Certificate {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  courseId          String
  course            Course   @relation(fields: [courseId], references: [id])
  certificateNumber String   @unique
  certificateUrl    String
  verificationCode  String   @unique
  issuedAt          DateTime @default(now())

  @@index([certificateNumber])
  @@index([verificationCode])
}

// --- AI Engine ---
model AiTutorSession {
  id            String          @id @default(uuid())
  userId        String
  courseId      String
  lessonId      String
  title         String
  modelName     String
  createdAt     DateTime        @default(now())
  lastMessageAt DateTime
  messages      AiChatMessage[]
}

model AiChatMessage {
  id        String         @id @default(uuid())
  sessionId String
  session   AiTutorSession @relation(fields: [sessionId], references: [id])
  userId    String
  role      String
  message   String
  tokenUsed Int
  createdAt DateTime       @default(now())
}

model AiKnowledgeDocument {
  id         String   @id @default(uuid())
  courseId   String
  lessonId   String
  title      String
  content    String
  fileUrl    String?
  sourceType String
  status     String
  createdAt  DateTime @default(now())
}

model AiEmbedding {
  id              String   @id @default(uuid())
  documentId      String
  courseId        String
  chunkText       String
  embeddingVector String // Stores vector data
  metadata        String? // JSON string
  createdAt       DateTime @default(now())
}

model AiGeneratedContent {
  id                   String   @id @default(uuid())
  courseId             String
  lessonId             String
  type                 String
  prompt               String
  output               String
  reviewedByInstructor Boolean  @default(false)
  createdAt            DateTime @default(now())
}

model AiLearningRecommendation {
  id                 String   @id @default(uuid())
  userId             String
  courseId           String
  weakTopics         String
  recommendedLessons String
  recommendedCourses String
  reason             String
  createdAt          DateTime @default(now())
}

// model AiSettings {
//   id           String  @id @default(uuid())
//   provider     String
//   modelName    String
//   baseUrl      String
//   maxTokens    Int
//   temperature  Decimal
//   systemPrompt String
//   isActive     Boolean @default(true)
// }


model AiSettings {
  id        String   @id @default(uuid())
  settings  Json     
  updatedAt DateTime @updatedAt

  @@map("ai_settings")
}

// --- Communication ---
model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  message   String
  type      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model NotificationTemplate {
  id      String @id @default(uuid())
  slug    String @unique
  title   String
  message String
  type    String
}

model Announcement {
  id         String   @id @default(uuid())
  courseId   String
  createdBy  String
  title      String
  message    String
  targetRole String
  createdAt  DateTime @default(now())
}

// --- Payments & Settings ---
model Coupon {
  id                String   @id @default(uuid())
  code              String   @unique
  discountType      String
  discountTypeValue Decimal
  courseId          String
  maxUses           Int
  usedCount         Int      @default(0)
  startDate         DateTime
  endDate           DateTime
  status            String
  createdAt         DateTime @default(now())
}

model CouponUsage {
  id             String   @id @default(uuid())
  couponId       String
  userId         String
  orderId        String
  discountAmount Decimal
  usedAt         DateTime @default(now())
}

model Order {
  id          String @id @default(uuid())
  orderNumber String @unique
  userId      String
  user        User   @relation(fields: [userId], references: [id])
  courseId    String

  course Course @relation(fields: [courseId], references: [id])

  amount         Decimal
  discountAmount Decimal
  taxAmount      Decimal
  totalAmount    Decimal
  currency       String
  status         String
  couponId       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([courseId, status])
  @@index([userId])
}

model Payment {
  id                    String    @id @default(uuid())
  orderId               String
  userId                String
  courseId              String
  provider              String
  providerTransactionId String
  amount                Decimal
  currency              String
  status                String
  gatewayResponse       String
  paidAt                DateTime?
  createdAt             DateTime  @default(now())
}

model Invoice {
  id             String   @id @default(uuid())
  invoiceNumber  String   @unique
  orderId        String
  userId         String
  courseId       String
  amount         Decimal
  discountAmount Decimal
  taxAmount      Decimal
  totalAmount    Decimal
  currency       String
  invoiceUrl     String
  issuedAt       DateTime @default(now())
}

// --- Logs & System ---
model LiveClass {
  id           String   @id @default(uuid())
  courseId     String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  instructorId String
  instructor   User     @relation("LiveClassInstructor", fields: [instructorId], references: [id])
  title        String
  description  String?
  meetingUrl   String
  startTime    DateTime
  endTime      DateTime
  recordingUrl String?
  status       String

  @@index([instructorId, startTime])
  @@index([courseId])
}

model Attendance {
  id              String    @id @default(uuid())
  liveClassId     String
  userId          String
  joinedAt        DateTime
  leftAt          DateTime?
  durationMinutes Int
  status          String

  user User @relation(fields: [userId], references: [id])
  @@unique([userId, liveClassId])
}

model ActivityLog {
  id         String   @id @default(uuid())
  userId     String
  action     String
  entityType String
  entityId   String
  ipAddress  String
  userAgent  String
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model Setting {
  id                 String  @id @default(uuid())
  
  
  siteName           String
  logo               String?
  favicon            String?
  defaultLanguage    String  @default("bn")
  

  allowRegistration  Boolean @default(true)
  certificateEnabled Boolean @default(true)
  aiEnabled          Boolean @default(false)
  maintenanceMode    Boolean @default(false)


  
  
  primaryColor       String  @default("#2563eb")
  secondaryColor     String  @default("#64748b")
  accentColor        String  @default("#f59e0b")
  

  backgroundColor    String  @default("#ffffff")
  surfaceColor       String  @default("#f8fafc")
  textColor          String  @default("#1e293b")
  textMutedColor     String  @default("#64748b")
  

  headerBackgroundColor String @default("#ffffff")
  headerTextColor       String @default("#1e293b")
  footerBackgroundColor String @default("#1e293b")
  footerTextColor       String @default("#ffffff")


  supportEmail       String?
  contactPhone       String?
  facebookUrl        String?
  youtubeUrl         String?
  

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

@@map("settings")
}


// =====================================================================
// --- SaaS layer (multi-tenant subscriptions) ---
// Mirrors the frontend contract in lms-admin-panel/src/types/saas.ts.
// =====================================================================

enum SaasBillingCycle {
  MONTHLY
  YEARLY
}

enum SaasSubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  SUSPENDED
}

enum SaasInvoiceStatus {
  PAID
  OPEN
  FAILED
  REFUNDED
  VOID
}

enum CustomDomainStatus {
  PENDING_DNS
  VERIFIED
  FAILED
}

enum InstitutionType {
  SCHOOL
  COACHING
  UNIVERSITY
  COMPANY
  CREATOR
}

enum InstitutionSource {
  SELF_SIGNUP
  OWNER_CREATED
}

enum SaasEventType {
  SIGNED_UP
  TRIAL_STARTED
  TRIAL_CONVERTED
  TRIAL_EXPIRED
  PLAN_UPGRADED
  PLAN_DOWNGRADED
  CYCLE_CHANGED
  PAYMENT_SUCCEEDED
  PAYMENT_FAILED
  CANCELLED
  REACTIVATED
  SUSPENDED
  DOMAIN_ADDED
  DOMAIN_VERIFIED
  NOTE
}

enum SaasActor {
  Owner
  Institution
  System
}

/// A pricing plan: built-in tiers ("starter" … "enterprise") or owner-created custom plans ("plan-<slug>").
model SaasPlan {
  id               String   @id
  name             String   @unique
  tagline          String
  /// USD per month. 0 = custom pricing ("Contact sales").
  priceMonthly     Decimal  @db.Decimal(12, 2)
  /// USD per year. 0 = custom pricing.
  priceYearly      Decimal  @db.Decimal(12, 2)
  /// Limits — null = unlimited.
  limitStudents    Int?
  limitCourses     Int?
  limitTeamMembers Int?
  limitStorageGb   Int?
  features         String[]
  highlighted      Boolean  @default(false)
  isPublic         Boolean  @default(true)
  trialDays        Int      @default(14)
  archived         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  institutions Institution[]
  invoices     SaasInvoice[]

  @@map("saas_plans")
}

/// One tenant. Carries exactly one subscription (flattened `sub*` columns).
model Institution {
  id           String            @id @default(uuid())
  name         String
  slug         String            @unique
  logoInitials String
  tone         String            @default("orange")
  type         InstitutionType
  country      String
  ownerName    String
  ownerEmail   String
  phone        String            @default("")
  notes        String            @default("")
  source       InstitutionSource @default(OWNER_CREATED)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  lastActiveAt DateTime          @default(now())

  // usage counters (kept in sync by the LMS modules once tenancy is wired)
  usageStudents    Int   @default(0)
  usageCourses     Int   @default(0)
  usageTeamMembers Int   @default(1)
  usageStorageGb   Float @default(0)

  // subscription
  planId              String
  plan                SaasPlan                @relation(fields: [planId], references: [id])
  cycle               SaasBillingCycle        @default(MONTHLY)
  status              SaasSubscriptionStatus
  startedAt           DateTime                @default(now())
  trialEndsAt         DateTime?
  currentPeriodStart  DateTime
  currentPeriodEnd    DateTime
  cancelAtPeriodEnd   Boolean                 @default(false)
  cancelledAt         DateTime?
  suspendedAt         DateTime?
  suspendedReason     String?
  statusBeforeSuspend SaasSubscriptionStatus?
  /// Negotiated price PER BILLING CYCLE — overrides the plan price when set.
  customPrice         Decimal?                @db.Decimal(12, 2)
  paymentBrand        String?
  paymentLast4        String?

  customDomain CustomDomain?
  invoices     SaasInvoice[]
  events       SaasEvent[]
  users        User[]

  @@index([status])
  @@index([planId])
  @@index([ownerEmail])
  @@map("institutions")
}

model CustomDomain {
  id            String             @id @default(uuid())
  institutionId String             @unique
  institution   Institution        @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  domain        String             @unique
  status        CustomDomainStatus @default(PENDING_DNS)
  addedAt       DateTime           @default(now())
  verifiedAt    DateTime?
  dnsTarget     String
  txtToken      String
  lastCheckedAt DateTime?

  @@map("custom_domains")
}

model SaasInvoice {
  id            String            @id @default(uuid())
  /// e.g. "EDP-2026-00123"
  number        String            @unique
  institutionId String
  institution   Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  planId        String
  plan          SaasPlan          @relation(fields: [planId], references: [id])
  cycle         SaasBillingCycle
  amount        Decimal           @db.Decimal(12, 2)
  tax           Decimal           @db.Decimal(12, 2)
  total         Decimal           @db.Decimal(12, 2)
  status        SaasInvoiceStatus
  issuedAt      DateTime          @default(now())
  dueAt         DateTime
  paidAt        DateTime?
  periodStart   DateTime
  periodEnd     DateTime
  description   String?

  @@index([institutionId, status])
  @@index([status])
  @@index([issuedAt])
  @@map("saas_invoices")
}

/// Per-institution lifecycle timeline.
model SaasEvent {
  id            String        @id @default(uuid())
  institutionId String
  institution   Institution   @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  type          SaasEventType
  message       String
  actor         SaasActor     @default(Owner)
  at            DateTime      @default(now())

  @@index([institutionId, at])
  @@index([at])
  @@map("saas_events")
}

/// Atomic counters (e.g. invoice numbers per year: key "invoice-2026").
model SaasCounter {
  key   String @id
  value Int    @default(0)

  @@map("saas_counters")
}


// --- Student notes (admin panel › Student details › Notes) ---
enum StudentNoteCategory {
  GOOD_PROGRESS
  NEEDS_IMPROVEMENT
  STUDENT_SUPPORT
  COUNSELING_CALL
  PAYMENT_ISSUE
  GENERAL
}

model StudentNote {
  id        String              @id @default(uuid())
  studentId String
  student   User                @relation("NoteStudent", fields: [studentId], references: [id], onDelete: Cascade)
  authorId  String
  author    User                @relation("NoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  category  StudentNoteCategory @default(GENERAL)
  content   String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  @@index([studentId, createdAt])
  @@map("student_notes")
}


// --- Instructor notes (admin panel › Instructor details › Notes) ---
enum InstructorNoteType {
  GENERAL
  PERFORMANCE
  CONTENT_UPDATE
  ONBOARDING
  MEETING
  ISSUE
  PAYMENT
}

enum NotePriority {
  LOW
  MEDIUM
  HIGH
}

model InstructorNote {
  id           String             @id @default(uuid())
  instructorId String
  instructor   User               @relation("InstructorNoteInstructor", fields: [instructorId], references: [id], onDelete: Cascade)
  authorId     String
  author       User               @relation("InstructorNoteAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  title        String
  /// Sanitized HTML from the rich text editor.
  content      String
  type         InstructorNoteType @default(GENERAL)
  priority     NotePriority       @default(MEDIUM)
  tags         String[]
  /// Calendar date of the reminder (no time).
  reminderDate DateTime?          @db.Date
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([instructorId, createdAt])
  @@map("instructor_notes")
}


// =====================================================================
// --- Team & Roles (admin-panel staff RBAC) ---
// Mirrors lms-admin-panel src/types/team.ts. Permissions are JSON maps
// { [module]: action[] } validated by src/team/team-permissions.ts.
// =====================================================================

enum TeamMemberStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum TeamEventType {
  INVITED
  INVITE_RESENT
  INVITE_REVOKED
  JOINED
  ROLE_CHANGED
  SUSPENDED
  REACTIVATED
  REMOVED
  TWO_FA_ENABLED
  TWO_FA_RESET
  ROLE_CREATED
  ROLE_UPDATED
  ROLE_RESET
  ROLE_DELETED
  EXTRA_PERMISSIONS_GRANTED
  EXTRA_PERMISSIONS_REMOVED
}

model TeamRole {
  id                 String   @id @default(uuid())
  /// Tenant (null = legacy single-tenant workspace).
  institutionId      String?
  /// Built-in role key ("super-admin", "admin", "content", "support", "finance"); null for custom roles.
  systemKey          String?
  name               String
  description        String   @default("")
  tone               String   @default("gray")
  isSystem           Boolean  @default(false)
  isLocked           Boolean  @default(false)
  permissions        Json
  /// System roles: shipped preset for "Reset to default". null for custom roles.
  defaultPermissions Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  members TeamMember[]

  @@index([institutionId])
  @@map("team_roles")
}

model TeamMember {
  id                String           @id @default(uuid())
  institutionId     String?
  /// Set once the invitation is accepted (or for the workspace owner).
  userId            String?          @unique
  user              User?            @relation("TeamMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  email             String
  roleId            String
  role              TeamRole         @relation(fields: [roleId], references: [id])
  /// Additive grants on top of the role (never repeats a role permission).
  extraPermissions  Json
  status            TeamMemberStatus
  isOwner           Boolean          @default(false)
  joinedAt          DateTime?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // invitation (while status = INVITED)
  /// SHA-256 of the invitation token — the raw token is only ever in the email link.
  inviteTokenHash   String?          @unique
  inviteSentAt      DateTime?
  inviteExpiresAt   DateTime?
  inviteMessage     String?
  invitedById       String?
  invitedBy         User?            @relation("TeamMemberInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  inviteResentCount Int              @default(0)

  @@index([institutionId, status])
  @@index([institutionId, email])
  @@map("team_members")
}

model TeamEvent {
  id            String        @id @default(uuid())
  institutionId String?
  type          TeamEventType
  actorId       String?
  actorName     String
  /// Member or role the event is about (null once it was deleted).
  targetId      String?
  targetName    String
  detail        String        @default("")
  at            DateTime      @default(now())

  @@index([institutionId, at])
  @@map("team_events")
}
